{
  "expo": {
    "name": "TuneUp",
    "slug": "TuneUp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tuneup-logo.png",
    "scheme": "tuneup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tuneup-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/tuneup-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fmadera.TuneUp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/tuneup-logo.png",
          "imageWidth": 180
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      "react-native-audio-api"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4eb68170-e9ea-400f-bc03-61fba0b2f47d"
      }
    }
  }
}
